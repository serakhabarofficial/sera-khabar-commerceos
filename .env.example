# Supabase
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Pooler connection — host must be *.pooler.supabase.com (NOT .co).
# Used by startup migrations (migrateMultiTenancy, migrateStorefrontSettingsTable).
SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true

# Frontend (Vite)
VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# OpenAI (or any OpenAI-compatible provider)
# AI_PROVIDER:
#   "openai"      — default; uses OPENAI_API_KEY + https://api.openai.com/v1
#   "openrouter"  — uses OPENROUTER_API_KEY + https://openrouter.ai/api/v1
#   "compatible"  — any OpenAI-compatible gateway (GMI Cloud, self-hosted, etc.);
#                   reads AI_BASE_URL + AI_API_KEY from env
OPENAI_API_KEY=
AI_PROVIDER=openai                # "openai" (default) | "openrouter" | "compatible"
# Required when AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Required when AI_PROVIDER=compatible
AI_BASE_URL=
AI_API_KEY=
# Model slug passed to the gateway (e.g. nvidia/nemotron-3-ultra-550b-a55b:free
# for OpenRouter, MiniMaxAI/MiniMax-M3 for GMI Cloud, gpt-4o-mini for OpenAI).
AI_MODEL=
# Optional OpenRouter attribution headers (ignored by OpenAI / compatible providers)
OPENROUTER_SITE_URL=
OPENROUTER_APP_TITLE=

# Server-side storefront order protection.
# Temporarily set ORDER_PROTECTION_MODE=off to bypass fraud checks without
# deleting them. Set it back to active to enforce BLOCK/REVIEW decisions.
# Secrets must never be exposed to Vite.
ORDER_PROTECTION_MODE=off
ORDER_PROTECTION_HASH_SECRET=
# Server-only HMAC key (32+ characters), identical in storefront and Merchant Suite.
# Signs customer IP/device/checkout context; never expose via VITE_ variables.
STOREFRONT_CONTEXT_SECRET=
# Dedicated server-only key (32+ chars), shared with the storefront project.
# Signs campaign click receipts, /go middleware click cookies and route-cache purges.
CAMPAIGN_EDGE_SECRET=
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=
# GPT-4o-mini checks every otherwise eligible order's address, notes, and abuse/fake-content signals.
PORT=5100

# Custom storefront domain (single-tenant: one Vercel storefront project per fork).
# Auto-provisioned storefront (Vercel). When a merchant clicks "Provision
# Storefront" in Settings, Commerce-os creates a new Vercel project from the
# default storefront GitHub repo, injects env vars, and deploys it. The custom
# domain card then attaches the merchant's domain to THAT project (per-merchant,
# org-scoped in app_settings — no global project id needed).
# Set these during onboarding. Without VERCEL_ACCESS_TOKEN the button errors
# with a clear message; without MERCHANT_SUITE_PUBLIC_URL the env vars can't be
# baked in, so set the public URL of THIS Merchant Suite deploy.
VERCEL_ACCESS_TOKEN=
STOREFRONT_GIT_REPO=serakhabarofficial/sera-khabar-storefront
MERCHANT_SUITE_PUBLIC_URL=
STOREFRONT_VERCEL_TEAM_ID=
# Automatic storefront SEO deployments. Set only in Merchant Suite server/Vercel settings.
VERCEL_PROJECT_ID=
CRON_SECRET=

# PostHog (merchant analytics pipeline — powers the Order Analysis funnel).
# PER MERCHANT: each fork gets its OWN PostHog project. During onboarding you
# create a PostHog project for that merchant and paste its keys here. Events are
# still tagged with org_id, but the project itself is per-merchant — merchants
# never share a PostHog account.
POSTHOG_PROJECT_API_KEY=
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
# POSTHOG_HOST= only set if self-hosting (defaults to https://app.posthog.com)

# Public Cloudflare cache purge (optional; existing storefront config caching)
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
PUBLIC_DOMAIN=
